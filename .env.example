# No keys are required for the local MVP.
ENVIRONMENT=local
SCAM_TRIAGE_TRACE_DIR=logs

# Enable when ready to use LangSmith.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=aegis-fraud-triage

# Enable when an OTLP collector is available.
# OTEL_EXPORTER_OTLP_ENDPOINT=

# Required before starting the local Grafana stack. Keep these only in .env.
# GRAFANA_ADMIN_USER=aegis-admin
# GRAFANA_ADMIN_PASSWORD=

# Reserved for retrieval provider integration after approved policy documents are indexed.
# PINECONE_API_KEY=
# PINECONE_INDEX_NAME=
# PINECONE_NAMESPACE=policy-v1
# PINECONE_EMBEDDING_MODEL=multilingual-e5-large
# RAG_BACKEND=local

# Optional evidence-constrained response drafting. Deterministic fallback stays active on any provider error.
# LLM_GENERATION_MODE=deterministic
# NEBIUS_API_KEY=
# NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1
# NEBIUS_AGENT_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
# NEBIUS_JUDGE_MODEL=meta-llama/Llama-3.3-70B-Instruct
# NEBIUS_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
# NEBIUS_TIMEOUT_SECONDS=30
# NEBIUS_MAX_TOKENS=700
